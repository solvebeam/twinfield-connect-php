<?xml version="1.0"?>

<ruleset name="SolveBeam Twinfield Connect">
  <description>PHPCS ruleset for PSR-12.</description>

  <rule ref="PSR12" />

  <file>.</file>

  <exclude-pattern type="relative">^vendor/*</exclude-pattern>

  <arg name="extensions" value="php" />
  <arg name="colors" />
  <arg name="parallel" value="4" />
</ruleset>
