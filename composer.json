{
  "name": "solvebeam/twinfield-connect",
  "description": "Log in to Twinfield through Twinfield Connect, without a Twinfield client ID of your own",
  "license": "MIT",
  "authors": [
    {
      "name": "SolveBeam",
      "email": "info@solvebeam.com",
      "homepage": "https://www.solvebeam.com/",
      "role": "Company"
    },
    {
      "name": "Remco Tolsma",
      "email": "remco@solvebeam.com",
      "homepage": "https://www.remcotolsma.nl/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/solvebeam/twinfield-connect-php/issues",
    "source": "https://github.com/solvebeam/twinfield-connect-php"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/solvebeam"
    }
  ],
  "keywords": [
    "twinfield",
    "oauth",
    "oauth2",
    "client",
    "authorization",
    "authentication",
    "league"
  ],
  "autoload": {
    "psr-4": {
      "SolveBeam\\Twinfield\\Connect\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SolveBeam\\Twinfield\\Connect\\Examples\\": "examples/",
      "SolveBeam\\Twinfield\\Connect\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^7.4.5",
    "league/oauth2-client": "^2.9",
    "solvebeam/oauth2-twinfield": "^0.1.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12",
    "squizlabs/php_codesniffer": "^3.10 || ^4.0"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse --no-progress",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
